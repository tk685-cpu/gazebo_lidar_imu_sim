<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    3D spinning lidar macro (modeled after a Velodyne VLP-16 style sensor):
    16 vertical channels over a +-15 deg vertical FOV, full 360 deg horizontal
    sweep, published as both a sensor_msgs/LaserScan (single mid-plane ring)
    and a full sensor_msgs/PointCloud2 via the gz gpu_lidar sensor.
  -->
  <xacro:macro name="lidar_3d" params="parent name:=lidar xyz:='0 0 0' rpy:='0 0 0'">

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <link name="${name}_link">
      <visual>
        <geometry>
          <cylinder radius="0.04" length="0.06"/>
        </geometry>
        <material name="black">
          <color rgba="0.05 0.05 0.05 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.04" length="0.06"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <gazebo reference="${name}_link">
      <material>Gazebo/Black</material>
      <sensor name="${name}" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>${name}</topic>
        <gz_frame_id>${name}_link</gz_frame_id>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>440</samples>
              <resolution>1</resolution>
              <min_angle>-3.141592653589793</min_angle>
              <max_angle>3.141592653589793</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.2617993877991494</min_angle>
              <max_angle>0.2617993877991494</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.15</min>
            <max>100.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>
